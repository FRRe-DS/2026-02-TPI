# Puerto de escucha del microservicio M3
SERVER_PORT=3003

# Conexión a la base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/m3_db
SPRING_DATASOURCE_USERNAME=m3_user
SPRING_DATASOURCE_PASSWORD=m3_password

# Identidad y Acceso (M1 / Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/ds-2025-realm
OIDC_JWKS_URI=http://keycloak:8080/realms/ds-2025-realm/protocol/openid-connect/certs
OIDC_AUDIENCE=account
# Cliente M3 registrado en M1, con redirect URI http://localhost:3003/login/oauth2/code/keycloak
OIDC_WEB_CLIENT_ID=m3-web-client
OIDC_WEB_CLIENT_AUTH_METHOD=none
OIDC_WEB_CLIENT_SECRET=
OIDC_TECH_CLIENT_ID=
OIDC_TECH_CLIENT_SECRET=
OIDC_TECH_TOKEN_URI=http://keycloak:8080/realms/ds-2025-realm/protocol/openid-connect/token
OIDC_AUTH_URI=http://localhost:8080/realms/ds-2025-realm/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://keycloak:8080/realms/ds-2025-realm/protocol/openid-connect/token
OIDC_USERINFO_URI=http://keycloak:8080/realms/ds-2025-realm/protocol/openid-connect/userinfo
# true al servir la web mediante HTTPS
SESSION_COOKIE_SECURE=false

# Integraciones con otros microservicios
# M4 Grupo 03 publica la API en el puerto 8000 de su compose; usar la URL del entorno integrador acordado.
M4_BASE_URL=http://localhost:3004
# Scope del token técnico para M4. Vacío = sin parámetro scope (M4 Grupo 03 valida el rol conductores-be).
M4_TOKEN_SCOPE=
# Roles o scopes que cuentan como "servicio" para que M4/M5/M6 lean /api/v1/conductores/{id}/estado, /ubicacion y /vehiculos/{id}
M3_SERVICE_READ_ROLES=SERVICIO,SCOPE_m3:drivers:read,ubicacion-be,solicitud-be,viajes-be
M6_BASE_URL=http://localhost:3006
# M5 Grupo 04 escucha según su despliegue; M5 exige el scope m5:offers:respond en el token de M3
M5_BASE_URL=http://localhost:3005
M5_TOKEN_SCOPE=m5:offers:respond
# Roles con los que M5 puede entregar ofertas a M3 (además del scope m5:offers:write)
M3_M5_OFFER_ROLES=SERVICIO,solicitud-be
# M6 autoriza por rol de servicio; vacío = sin parámetro scope
M6_TOKEN_SCOPE=
# Consulta periódica de viajes activos en M6 (fin y cancelación)
M6_SYNC_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# Producción: no acepta identidades de desarrollo
SPRING_PROFILES_ACTIVE=production
M4_WORKER_ENABLED=true
