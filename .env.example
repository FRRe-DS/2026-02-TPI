# Puerto de escucha del microservicio M3
SERVER_PORT=3003

# Conexión a la base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/m3_db
SPRING_DATASOURCE_USERNAME=m3_user
SPRING_DATASOURCE_PASSWORD=m3_password

# Identidad y Acceso (M1 / Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/clonuber
OIDC_JWKS_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/certs
OIDC_AUDIENCE=m3-service
OIDC_WEB_CLIENT_ID=m3-web-client
OIDC_WEB_CLIENT_SECRET=m3-web-secret
OIDC_SERVICE_CLIENT_ID=m3-service-client
OIDC_SERVICE_CLIENT_SECRET=m3-service-secret

# Integraciones con otros microservicios
M4_BASE_URL=http://localhost:3004
M6_BASE_URL=http://localhost:3006
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# Modo de ejecución (local | real)
INTEGRATION_MODE=local
