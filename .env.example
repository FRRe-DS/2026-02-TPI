# Puerto de escucha del microservicio M3
SERVER_PORT=3003

# Conexión a la base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/m3_db
SPRING_DATASOURCE_USERNAME=m3_user
SPRING_DATASOURCE_PASSWORD=m3_password

# Identidad y Acceso (M1 / Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/clonuber
OIDC_JWKS_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/certs
OIDC_AUDIENCE=m3-service
OIDC_WEB_CLIENT_ID=m3-web-client
OIDC_WEB_CLIENT_SECRET=
OIDC_TECH_CLIENT_ID=m3-service-client
OIDC_TECH_CLIENT_SECRET=
OIDC_TECH_TOKEN_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/token
OIDC_AUTH_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/token
OIDC_USERINFO_URI=http://localhost:8080/realms/clonuber/protocol/openid-connect/userinfo
# true al servir la web mediante HTTPS
SESSION_COOKIE_SECURE=false

# Integraciones con otros microservicios
M4_BASE_URL=http://localhost:3004
M6_BASE_URL=http://localhost:3006
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# Producción: no acepta identidades de desarrollo
SPRING_PROFILES_ACTIVE=production
M4_WORKER_ENABLED=true
