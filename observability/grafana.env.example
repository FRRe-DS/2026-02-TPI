# Copiar a .env.grafana.local en la raíz. Nunca guardar el token real aquí.
# Usar el endpoint BASE exacto del tile OpenTelemetry del stack (suele terminar en /otlp).
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
# Valor completo de Authorization: Basic seguido de base64(instance-id:token).
# No copiar literalmente OTEL_EXPORTER_OTLP_HEADERS con el prefijo Authorization=.
# Usuario OTLP del stack del Equipo 2: 1936646. Generar localmente con Set-GrafanaCredentials.ps1.
GRAFANA_OTLP_AUTH="Basic REEMPLAZAR"
